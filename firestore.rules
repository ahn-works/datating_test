rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // 1. [클라우드플레어 R2 및 서버 시크릿 차단]
    // - Cloudflare R2 Secret Access Key, Access Key ID, API 토큰 클라이언트 접근 100% 차단
    // - Solapi SMS API Secret 및 대표님 개인 발신번호 외부 접근 100% 차단
    // ===============================================================
    match /config/{docId} {
      allow read, write: if false;
    }
    match /config/r2_storage {
      allow read, write: if false;
    }
    match /system_config/{docId} {
      allow read, write: if false;
    }
    match /system_config/r2_storage {
      allow read, write: if false;
    }
    match /phone_verifications/{phone} {
      allow read, write: if false;
    }

    // ===============================================================
    // 2. [클라우드플레어 퍼블릭 CDN 및 앱 공지/런타임 설정]
    // - Cloudflare R2 공개 이미지 CDN 주소(r2_public) 및 일반 공지/점검 설정은 허용
    // - Solapi 키, R2 비밀키(r2_storage) 등 시크릿 문서는 클라이언트 조회 절대 차단
    // ===============================================================
    match /app_config/r2_public {
      allow get: if true;
      allow write: if false;
    }
    match /app_config/{docId} {
      allow get: if docId != 'solapi' &&
                    docId != 'api_keys' &&
                    docId != 'r2_storage' &&
                    docId != 'naver_auth';
      allow list, write: if false;
    }

    // ===============================================================
    // 3. [사용자 프로필 및 개인정보 완벽 분리]
    // ===============================================================
    match /users/{userId} {
      // 공개 프로필(닉네임, 아바타, 매너온도 등)은 누구나 조회 가능
      allow get, list: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);

      // 전화번호, 이메일 등 민감 개인정보는 본인과 관리자만 열람/수정 가능
      match /private/{docId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
      }

      // 개인별 실시간 알림 서브컬렉션 (백엔드 수정 및 처리 완료 시 알림 수신)
      match /notifications/{notifId} {
        allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
        allow write: if request.auth != null;
      }
    }

    // ===============================================================
    // 4. [루트 실시간 알림 (모임 승인, 문의 답변, 백엔드 상태 변경 알림)]
    // ===============================================================
    match /notifications/{notifId} {
      // 본인에게 온 알림 또는 관리자만 조회 가능
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.admin == true);
      // 알림 생성은 로그인 사용자 및 백엔드 요청 모두 허용
      allow create: if request.auth != null;
      // 알림 읽음 처리 및 삭제는 본인 또는 관리자만
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.admin == true);
    }

    // ===============================================================
    // 5. [1:1 고객 문의 및 백엔드 수정 요청]
    // ===============================================================
    match /inquiries/{inquiryId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.admin == true);
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // ===============================================================
    // 6. [모임 (동네 모임, 번개, 참여 신청 요청)]
    // ===============================================================
    match /meetups/{meetupId} {
      allow read: if true;
      allow write: if request.auth != null;

      // 모임 참여 신청 요청 (호스트 승인 시 알림 연동)
      match /applications/{appId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }

      match /{sub=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // ===============================================================
    // 7. [커뮤니티 (동네 게시글 및 댓글)]
    // ===============================================================
    match /community_posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /{sub=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // ===============================================================
    // 8. [채팅방 및 메시지]
    // ===============================================================
    match /chatRooms/{roomId} {
      allow read, write: if request.auth != null;

      match /{sub=**} {
        allow read, write: if request.auth != null;
      }
    }

    // ===============================================================
    // 9. [트렌드 이벤트 및 전체 공지사항]
    // ===============================================================
    match /trend_events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // ===============================================================
    // 10. [유저 신고 접수]
    // ===============================================================
    match /reports/{reportId} {
      allow create, read: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // ===============================================================
    // 11. [기본 차단 (명시되지 않은 모든 경로는 무조건 차단)]
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
