# ==============================================================================
# OOMU Environment Configuration Template (.env.example)
# Copy this file to .env and provide your secrets/configuration locally.
# NEVER commit .env to git or Firestore!
# ==============================================================================

# Slack Bot Token: Bot user OAuth token (starts with xoxb-).
# Scopes required: channels:history, channels:read, chat:write, files:read, files:write, incoming-webhook
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Slack Channel ID: Target Slack channel ID to read and post (e.g. C0CHC0S3KEW for #공지용)
SLACK_CHANNEL_ID=C0CHC0S3KEW

# Slack Webhook URL: Fallback incoming webhook URL for emergency notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
