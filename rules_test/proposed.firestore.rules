// 제안본(미게시). firebase.json 은 이 파일을 가리키지 않는다. 검증: cd rules_test && RULES_FILE=proposed.firestore.rules npm test
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // 1. [클라우드플레어 R2 및 서버 시크릿 차단]
    // - Cloudflare R2 Secret Access Key, Access Key ID, API 토큰 클라이언트 접근 100% 차단
    // - Solapi SMS API Secret 및 대표님 개인 발신번호 외부 접근 100% 차단
    // ===============================================================
    match /config/{docId} {
      allow read, write: if false;
    }
    match /config/r2_storage {
      allow read, write: if false;
    }
    match /system_config/{docId} {
      allow read, write: if false;
    }
    match /system_config/r2_storage {
      allow read, write: if false;
    }
    match /phone_verifications/{phone} {
      allow read, write: if false;
    }

    // ===============================================================
    // 2. [클라우드플레어 퍼블릭 CDN 및 앱 공지/런타임 설정]
    // - Cloudflare R2 공개 이미지 CDN 주소(r2_public) 및 일반 공지/점검 설정은 허용
    // - Solapi 키, R2 비밀키(r2_storage) 등 시크릿 문서는 클라이언트 조회 절대 차단
    // ===============================================================
    match /app_config/r2_public {
      allow get: if true;
      allow write: if false;
    }
    match /app_config/{docId} {
      allow get: if docId != 'solapi' &&
                    docId != 'api_keys' &&
                    docId != 'r2_storage' &&
                    docId != 'naver' &&
                    docId != 'naver_auth';
      allow list, write: if false;
    }

    // 주간 네이버 장소 수집 결과만 공개 조회. 문서 ID는 동네명 해시이며
    // 클라이언트 쓰기와 컬렉션 전체 조회는 허용하지 않는다.
    match /naver_region_places/{regionId} {
      allow get: if true;
      allow list, write: if false;
    }

    // ===============================================================
    // 3. [사용자 프로필 및 개인정보 완벽 분리]
    // ===============================================================
    match /users/{userId} {
      // 공개 프로필(닉네임, 아바타, 매너온도 등)은 조회 가능 (단, guest 오염 문서 제외)
      allow get, list: if userId != 'guest';
      allow create: if userId != 'guest'
        && request.auth != null
        && (request.auth.uid == userId || request.auth.token.admin == true)
        && !('phone' in request.resource.data)
        && !('phoneNumber' in request.resource.data)
        && !('email' in request.resource.data)
        && (!('role' in request.resource.data) || request.resource.data.role != 'admin' || request.auth.token.admin == true)
        && (!('mannerTemp' in request.resource.data) || request.resource.data.mannerTemp == 36.5 || request.auth.token.admin == true);
      allow update: if userId != 'guest'
        && request.auth != null
        && (request.auth.uid == userId || request.auth.token.admin == true)
        && !('phone' in request.resource.data)
        && !('phoneNumber' in request.resource.data)
        && (!('email' in request.resource.data) || request.resource.data.email == resource.data.email)
        && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role || request.auth.token.admin == true)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['mannerTemp']) || request.auth.token.admin == true);
      allow delete: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);

      // 전화번호, 이메일 등 민감 개인정보는 본인과 관리자만 열람/수정 가능
      match /private/{docId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
      }

      // 개인별 실시간 알림 서브컬렉션 (백엔드 수정 및 처리 완료 시 알림 수신)
      match /notifications/{notifId} {
        allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
        allow write: if false;
      }
    }

    // ===============================================================
    // 3-1. [봇 페르소나 전용 컬렉션 (실제 유저와 완전 분리)]
    // ===============================================================
    match /bots/{botId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // ===============================================================
    // 3-2. [사용자별 상태(채팅방 나가기 등)]
    // ===============================================================
    match /user_states/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
    }

    // ===============================================================
    // 4. [루트 실시간 알림 (모임 승인, 문의 답변, 백엔드 상태 변경 알림)]
    // ===============================================================
    match /notifications/{notifId} {
      // 본인에게 온 알림 또는 관리자만 조회 가능
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.admin == true);
      // 알림 생성은 로그인 사용자 및 백엔드 요청 모두 허용
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['userId', 'type', 'title', 'body', 'meetupId', 'read', 'createdAt'])
        && request.resource.data.read == false
        && request.resource.data.meetupId is string
        && ((request.resource.data.type == 'meetup_request'
              && exists(/databases/$(database)/documents/meetups/$(request.resource.data.meetupId)/applications/$(request.auth.uid))
              && get(/databases/$(database)/documents/meetups/$(request.resource.data.meetupId)).data.hostUid == request.resource.data.userId)
          || (request.resource.data.type == 'meetup_decision'
              && get(/databases/$(database)/documents/meetups/$(request.resource.data.meetupId)).data.hostUid == request.auth.uid
              && exists(/databases/$(database)/documents/meetups/$(request.resource.data.meetupId)/applications/$(request.resource.data.userId)))
          || request.auth.token.admin == true);
      // 알림 읽음 처리 및 삭제는 본인 또는 관리자만
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.admin == true);
    }

    // ===============================================================
    // 5. [1:1 고객 문의 및 백엔드 수정 요청]
    // ===============================================================
    match /inquiries/{inquiryId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.admin == true);
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // ===============================================================
    // 6. [모임 (동네 모임, 번개, 참여 신청 요청)]
    // ===============================================================
    match /meetups/{meetupId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.hostUid == request.auth.uid || request.auth.token.admin == true);

      // 모임 참여 신청 요청 (호스트 승인 시 알림 연동)
      match /applications/{appId} {
        allow get: if request.auth != null && (
          appId == request.auth.uid ||
          get(/databases/$(database)/documents/meetups/$(meetupId)).data.hostUid == request.auth.uid ||
          request.auth.token.admin == true);
        allow list: if request.auth != null && (
          get(/databases/$(database)/documents/meetups/$(meetupId)).data.hostUid == request.auth.uid ||
          request.auth.token.admin == true);
        allow create: if request.auth != null && appId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.partySize in [1, 2];
        allow update: if request.auth != null
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt'])
          && (get(/databases/$(database)/documents/meetups/$(meetupId)).data.hostUid == request.auth.uid ||
              request.auth.token.admin == true);
        allow delete: if request.auth != null && request.auth.token.admin == true;
      }
    }

    // ===============================================================
    // 7. [커뮤니티 (동네 게시글 및 댓글)]
    // ===============================================================
    function authoredByMe(data) {
      return ('authorId' in data || 'userId' in data) &&
        (!('authorId' in data) || data.authorId == request.auth.uid) &&
        (!('userId' in data) || data.userId == request.auth.uid);
    }
    function ownLikeChange() {
      let before = resource.data.get('likedUserIds', []);
      let after = request.resource.data.likedUserIds;
      let uid = request.auth.uid;
      return after is list && before is list &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedUserIds', 'likes']) &&
        after.size() == after.toSet().size() && request.resource.data.likes == after.size() &&
        ((!(uid in before) && after.toSet() == before.toSet().union([uid].toSet())) ||
         (uid in before && after.toSet() == before.toSet().difference([uid].toSet())));
    }
    match /community_posts/{postId} {
      allow update: if request.auth != null && ownLikeChange();
      allow read: if true;
      allow create: if request.auth != null && authoredByMe(request.resource.data);
      allow update, delete: if request.auth != null && (resource.data.authorId == request.auth.uid || resource.data.userId == request.auth.uid || request.auth.token.admin == true);

      // 커뮤니티 게시글 댓글
      match /comments/{commentId} {
        allow update: if request.auth != null && ownLikeChange();
        allow read: if true;
        allow create: if request.auth != null && authoredByMe(request.resource.data);
        allow update, delete: if request.auth != null && (resource.data.authorId == request.auth.uid || resource.data.userId == request.auth.uid || request.auth.token.admin == true);
      }
    }

    // ===============================================================
    // 8. [채팅방 및 메시지]
    // ===============================================================
    match /chatRooms/{roomId} {
      allow get: if request.auth != null && (resource.data.participants is list && request.auth.uid in resource.data.participants || request.auth.token.admin == true);
      // The client uses where('participants', arrayContains: auth.uid).
      // Keep the list predicate query-compatible; missing/non-array fields do not match.
      allow list: if request.auth != null && (request.auth.uid in resource.data.participants || request.auth.token.admin == true);
      allow create: if request.auth != null
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants
        && (!('meetupId' in request.resource.data) ||
          (roomId == request.resource.data.meetupId &&
           getAfter(/databases/$(database)/documents/meetups/$(roomId)).data.hostUid == request.auth.uid));
      allow update: if request.auth != null && (
        request.auth.token.admin == true ||
        (resource.data.participants is list && request.auth.uid in resource.data.participants && (
          resource.data.hostUid == request.auth.uid ||
          (request.resource.data.participants == resource.data.participants &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt'])) ||
          (request.resource.data.participants == resource.data.participants.removeAll([request.auth.uid]) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'leftUserIds', 'updatedAt']))
        )));
      allow delete: if request.auth != null && request.auth.token.admin == true;

      // 채팅방 메시지 (참여자 또는 관리자만 읽기 허용)
      match /messages/{msgId} {
        allow read: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants ||
          request.auth.token.admin == true
        );
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants &&
          request.resource.data.senderId == request.auth.uid &&
          (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid);
        allow update, delete: if request.auth != null && (resource.data.senderId == request.auth.uid || resource.data.userId == request.auth.uid || request.auth.token.admin == true);
        // 투표·일정·응원·프로필교환 카드 응답: 참여자는 응답 필드만 수정
        allow update: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voters', 'attendees', 'cheers', 'acceptedMembers', 'status', 'secretChoices', 'submittedAt']);
      }
    }

    // ===============================================================
    // 9. [트렌드 이벤트 및 전체 공지사항]
    // ===============================================================
    match /trend_events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // ===============================================================
    // 10. [유저 신고 접수]
    // ===============================================================
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // ===============================================================
    // 11. [기본 차단 (명시되지 않은 모든 경로는 무조건 차단)]
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
